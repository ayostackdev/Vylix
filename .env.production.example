# ─── Database (Supabase) ─────────────────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Storage Provider ─────────────────────────────────────
# "r2" (recommended, zero egress) | "supabase" (default) | "appwrite"
STORAGE_PROVIDER=supabase

# ─── Cloudflare R2 (primary object storage) ───────────────
# S3-compatible; credentials from R2 bucket settings.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_STORAGE_BUCKET="vylix-materials"
R2_AVATARS_BUCKET="vylix-avatars"
# Optional public base URL per bucket (r2.dev hostname or custom domain);
# when unset the API falls back to short-lived presigned URLs.
R2_STORAGE_PUBLIC_BASE_URL=""
R2_AVATARS_PUBLIC_BASE_URL=""

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL="https://ntxcmqouahvqylmgoyjp.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="materials"
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_JWT_SECRET=""

# ─── AI ──────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Vector Search ────────────────────────────────────────
# The provider MUST match the image you deployed. The two are not
# interchangeable, and nothing raises an error when they disagree:
#   bge-m3  — self-hosted dense+sparse (1024-dim). No per-call cost, and the
#             sparse lexical signal is what makes exact matches ("MTH101")
#             rank correctly. Requires the `api-run` image, i.e. the Contabo
#             overlay (docker-compose.contabo.yml). On the lean `api-lean`
#             image FlagEmbedding is absent, so the API silently falls back
#             to Gemini (or hashing) while the worker still stores 1024-dim
#             BGE-M3 vectors — the dimensions no longer match the stored
#             vectors' provenance and semantic search quietly stops working.
#   gemini  — works with the lean `api-lean` image (Render, or the Contabo
#             lean path). ~$0.10 per 1M tokens. Dense-only: no sparse lexical
#             signal, so exact course-code matches rank worse.
#   hashing — local bag-of-words, dev only (256-dim; does not fit pgvector).
# The default below matches the base docker-compose.prod.yml (lean image).
# Switch to "bge-m3" ONLY when layering docker-compose.contabo.yml, which
# rebuilds the API from the full `api-run` target.
EMBEDDING_PROVIDER="gemini"
BGE_M3_MODEL="BAAI/bge-m3"
BGE_M3_DEVICE="cpu"
# Candidate pool for the dense pass; the rest is a Python dense+sparse rerank.
EMBEDDING_CANDIDATE_COUNT=50
EMBEDDING_DENSE_WEIGHT=0.5
# BGE-M3 ColBERT MaxSim rerank over the top candidates (0 disables; no storage cost).
# Set to 0 on a small VPS: the rerank re-encodes the query AND every candidate
# document on CPU, which is tens of seconds to minutes per search on shared vCPU.
EMBEDDING_COLBERT_WEIGHT=0.6
EMBEDDING_RERANK_CANDIDATES=20
VECTOR_STORE_BACKEND="auto"

# ─── Error Tracking ──────────────────────────────────────
# Sentry DSN from https://sentry.io → Projects → Vylix API → Client Keys
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: Slack/Discord webhook for critical alerts (webhook failures, Celery deaths)
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ─── Google Drive ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://api.vylix.app/api/google-drive/callback"
FRONTEND_URL="https://vylix.vercel.app"

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_API_KEY=""

# ─── CORS ────────────────────────────────────────────────
# The API refuses to start without this (main.py exits FATAL if unset).
# Web (Vercel) domain goes here; CORS also auto-allows any *.vercel.app.
CORS_ORIGINS="https://vylix.vercel.app,http://localhost:3000"

# ─── Monnify ─────────────────────────────────────────────
# Get from https://dashboard.monnify.com -> API Keys & Webhooks
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
# Contract reserved for web transactions (reserve-account contract for transfers)
MONNIFY_CONTRACT_CODE=""
# Sandbox default; switch to https://api.monnify.com for live traffic
MONNIFY_BASE_URL="https://sandbox.monnify.com"
# Webhook signature uses the client secret (MONNIFY_SECRET_KEY) per Monnify docs.
# Webhook must point to: https://api.vylix.app/api/v1/payments/webhook

# ─── Celery / Redis ──────────────────────────────────────
# API Redis (DB 0): rate-limiting + caching. Volatile-lru so only TTL'd
# keys (rate-limit counters, caches) are evicted under memory pressure.
# Celery Redis (separate container): broker + result backend. Isolated so
# Celery result TTLs can never evict your rate-limit keys.
# docker-compose.prod.yml injects:
#   REDIS_URL=redis://redis:6379/0
#   CELERY_BROKER_URL=redis://redis-celery:6379/0
#   CELERY_RESULT_BACKEND=redis://redis-celery:6379/1

# ─── Process sizing (tuned for a 12 GB VPS) ────────────────
# uvicorn workers in the API container. The lean image's CMD expands
# ${WEB_CONCURRENCY:-2}; 1 keeps a small VPS comfortable, 2 is fine on the
# lean path (each worker is a separate process with its own copy of the app).
# The Celery worker's concurrency is set in docker-compose.prod.yml
# (CELERY_CONCURRENCY, default 1) — it is a compose override because the
# image CMD is exec-form and cannot expand environment variables.
WEB_CONCURRENCY=1

# NOTE: Fill in the blank values above before deploying.
# Get Supabase connection strings from: Dashboard > Settings > Database > Connection string > URI

# ─── Admin ───────────────────────────────────────────────
# Comma-separated emails that get admin role on first login
ADMIN_EMAILS="ayostackdev@gmail.com"
