# ─── Supabase (required) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=material
SUPABASE_AVATARS_BUCKET=avatars

# ─── Maintenance API (required) ───────────────────────────
MAINTENANCE_API_KEY=

# ─── AI / Gemini (optional — Python service falls back) ──
GEMINI_API_KEY=

# ─── Vector Search ──────────────────────────────────────────
# bge-m3 (self-hosted dense+sparse, default) | gemini | hashing
EMBEDDING_PROVIDER=bge-m3
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cpu
EMBEDDING_CANDIDATE_COUNT=50
EMBEDDING_DENSE_WEIGHT=0.5
EMBEDDING_COLBERT_WEIGHT=0.6
EMBEDDING_RERANK_CANDIDATES=20
VECTOR_STORE_BACKEND=auto
