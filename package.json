{
  "name": "vylix",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @vylix/web",
    "dev:api": "npm run start:dev -w @vylix/api",
    "dev:worker": "npm run start:dev:worker -w @vylix/api",
    "dev:python": "npm run dev -w @vylix/python-service",
    "build": "npm run build -w @vylix/web && npm run build -w @vylix/api",
    "heroku:build": "npm run build -w @vylix/api",
    "heroku:start": "npm run start -w @vylix/api",
    "heroku:worker": "npm run start:worker -w @vylix/api",
    "heroku:release": "npm run prisma:deploy -w @vylix/api",
    "heroku-postbuild": "npm run heroku:build",
    "lint": "npm run lint -w @vylix/web && npm run lint -w @vylix/api",
    "clean": "node scripts/clean.mjs"
  }
}
