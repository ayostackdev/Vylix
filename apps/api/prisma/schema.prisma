generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
    id                     String     @id @default(uuid())
    fullName               String
    matricNumber           String     @unique
    entryYear              Int
    currentLevel           String?
    levelUpdatedAt         DateTime?
    schoolEmail            String?
    status                 UserStatus @default(STUDENT)
    graduatedAt            DateTime?
    collegeId              String
    departmentId           String
    bio                    String?
    avatarUrl              String?
    contributionScore      Int        @default(0) // Gamification score
    schoolEmailPromptDismissedAt DateTime?
    emailPromptDismissedAt DateTime?
    createdAt              DateTime   @default(now())
    updatedAt              DateTime   @updatedAt

    college                 College              @relation(fields: [collegeId], references: [id], onDelete: Restrict)
    department              Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
    vaultItems              VaultItem[]
    topicsCreated           Topic[]              @relation("TopicAuthor")
    materials               Material[]
    lessonsHosted           Lesson[]             @relation("LessonHost")
    rsvps                   RSVP[]
    emails                  UserEmail[]
    privacy                 UserPrivacy?
    badges                  UserBadge[]
    profile                 UserProfile?
    conversationMemberships ConversationMember[]
    messagesSent            Message[]            @relation("MessageSender")
    messagesRead            MessageReadReceipt[]
    conversationsCreated    Conversation[]
    notifications           Notification[]
    streak                  UserStreak?          @relation(fields: [userStreakId], references: [id])
    pointsTransactions      PointsTransaction[]
    rewardPurchases         UserRewardPurchase[]
    questionsAsked          TopicQuestion[]      @relation("QuestionAuthor")
    answersProvided         QuestionAnswer[]     @relation("AnswerAuthor")
    userStreakId            String?

    @@index([departmentId])
    @@index([collegeId])
    @@index([currentLevel])
    @@index([status])
}

model UserPrivacy {
    id                String   @id @default(uuid())
    userId            String   @unique
    isStealthMode     Boolean  @default(false) // Anonymous posts in Public Pulse
    showContributions Boolean  @default(true) // Show badges and score on profile
    showEmail         Boolean  @default(false) // Show email on profile
    showDepartment    Boolean  @default(true) // Show department/college
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model UserProfile {
    id              String    @id @default(uuid())
    userId          String    @unique
    bio             String?
    website         String?
    socialLinks     Json? // { twitter, linkedin, github, etc }
    profileImageUrl String?
    bannerImageUrl  String?
    lastProfileView DateTime?
    viewCount       Int       @default(0)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Badge {
    id          String      @id @default(uuid())
    code        String      @unique // e.g., "top-contributor", "coleng-scholar"
    name        String // e.g., "Top Contributor"
    description String
    icon        String // URL to badge icon
    rarity      BadgeRarity @default(COMMON) // COMMON, RARE, EPIC, LEGENDARY
    criteria    String // Description of how to earn
    createdAt   DateTime    @default(now())

    users UserBadge[]

    @@index([rarity])
}

model UserBadge {
    id        String   @id @default(uuid())
    userId    String
    badgeId   String
    earnedAt  DateTime @default(now())
    awardedBy String? // Admin user ID if manually awarded

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

    @@unique([userId, badgeId])
    @@index([userId])
    @@index([badgeId])
}

model UserEmail {
    id         String   @id @default(uuid())
    email      String   @unique
    userId     String
    isPrimary  Boolean  @default(false)
    isVerified Boolean  @default(false)
    createdAt  DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([email])
}

model College {
    id            String @id @default(uuid())
    code          String @unique
    name          String
    durationYears Int    @default(4)

    departments Department[]
    users       User[]
}

model Department {
    id        String @id @default(uuid())
    code      String @unique
    name      String
    collegeId String

    college       College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
    courses       Course[]
    users         User[]
    conversations Conversation[]

    @@index([collegeId])
}

model Course {
    id           String  @id @default(uuid())
    code         String  @unique
    title        String
    level        Int
    departmentId String?
    isGeneral    Boolean @default(false)

    department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
    topics     Topic[]
    lessons    Lesson[]

    @@index([departmentId, isGeneral])
    @@index([departmentId])
}

model Topic {
    id           String   @id @default(uuid())
    title        String
    courseId     String
    authorId     String
    isActive     Boolean  @default(true)
    lastActivity DateTime @default(now()) @updatedAt

    course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
    author        User            @relation("TopicAuthor", fields: [authorId], references: [id], onDelete: Restrict)
    materials     Material[]
    conversations Conversation[]
    questions     TopicQuestion[]

    @@index([courseId])
    @@index([lastActivity])
    @@index([courseId, isActive, lastActivity])
}

model Material {
    id               String                   @id @default(uuid())
    fileName         String
    fileUrl          String
    fileSize         Int
    topicId          String
    uploaderId       String
    processingStatus MaterialProcessingStatus @default(QUEUED)
    processingJobId  String?
    summary          String?
    questions        Json?
    tips             Json?
    processingError  String?
    processedAt      DateTime?
    uploadedAt       DateTime                 @default(now())
    isSeed           Boolean                  @default(false)
    isPastQuestion   Boolean                  @default(false)
    examYear         Int?
    semester         String?

    topic    Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
    uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

    @@index([processingStatus])
    @@index([processingJobId])
    @@index([uploadedAt])
    @@index([topicId, uploadedAt])
    @@index([topicId, isSeed])
    @@index([isSeed])
}

model Conversation {
    id           String           @id @default(uuid())
    type         ConversationType @default(GROUP)
    title        String?
    departmentId String?
    topicId      String?
    createdById  String
    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @updatedAt

    department Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
    topic      Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
    createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
    members    ConversationMember[]
    messages   Message[]

    @@index([departmentId])
    @@index([topicId])
    @@index([createdById])
    @@index([updatedAt])
}

model ConversationMember {
    id             String           @id @default(uuid())
    conversationId String
    userId         String
    role           ConversationRole @default(MEMBER)
    lastReadAt     DateTime?
    joinedAt       DateTime         @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([conversationId, userId])
    @@index([userId])
    @@index([conversationId])
    @@index([lastReadAt])
}

model Message {
    id             String    @id @default(uuid())
    conversationId String
    senderId       String
    content        String
    metadata       Json?
    editedAt       DateTime?
    deletedAt      DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    conversation  Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender        User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
    receipts      MessageReadReceipt[]
    notifications Notification[]

    @@index([conversationId, createdAt])
    @@index([senderId])
    @@index([deletedAt])
    @@index([conversationId, deletedAt, createdAt])
}

model MessageReadReceipt {
    id        String   @id @default(uuid())
    messageId String
    userId    String
    readAt    DateTime @default(now())

    message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([messageId, userId])
    @@index([userId])
    @@index([messageId])
    @@index([readAt])
}

model Notification {
    id              String    @id @default(uuid())
    userId          String
    kind            String
    title           String
    message         String?
    payload         Json?
    sourceMessageId String?
    deliveredAt     DateTime  @default(now())
    readAt          DateTime?
    createdAt       DateTime  @default(now())

    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    sourceMessage Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

    @@index([userId])
    @@index([kind])
    @@index([readAt])
    @@index([createdAt])
    @@index([userId, readAt])
}

model VaultItem {
    id          String   @id @default(uuid())
    title       String
    userId      String
    localBlobId String
    savedAt     DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Lesson {
    id           String   @id @default(uuid())
    title        String
    description  String?
    scheduledFor DateTime
    location     String
    hostId       String
    courseId     String
    createdAt    DateTime @default(now())

    host   User   @relation("LessonHost", fields: [hostId], references: [id], onDelete: Restrict)
    course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
    rsvps  RSVP[]

    @@index([courseId, scheduledFor])
}

model RSVP {
    id          String     @id @default(uuid())
    userId      String
    lessonId    String
    status      RSVPStatus @default(GOING)
    respondedAt DateTime   @default(now()) @updatedAt

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

    @@unique([userId, lessonId])
}

model UserStreak {
    id              String   @id @default(uuid())
    userId          String   @unique
    currentStreak   Int      @default(0) // Days in current streak
    longestStreak   Int      @default(0) // Best ever streak
    lastActivityAt  DateTime @default(now()) // Last time user logged in
    streakStartedAt DateTime @default(now()) // When current streak started
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    users           User[]

    @@index([userId])
    @@index([currentStreak])
}

model PointsTransaction {
    id          String   @id @default(uuid())
    userId      String
    amount      Int // Positive = earned, negative = spent
    reason      String // "upload_material", "answer_helpful", "daily_streak", "daily_login", etc
    description String?
    relatedId   String? // Reference to material/answer/etc
    createdAt   DateTime @default(now())
    user        User     @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([createdAt])
    @@index([userId, createdAt])
}

model RewardItem {
    id          String   @id @default(uuid())
    code        String   @unique
    name        String // e.g., "Premium Notes Access", "Tutoring Credit"
    description String
    pointsCost  Int // How many points to redeem
    category    String // "access", "credit", "physical", etc
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())

    @@index([isActive])
    @@index([pointsCost])
}

model UserRewardPurchase {
    id         String    @id @default(uuid())
    userId     String
    rewardId   String
    code       String    @unique // Unique redemption code for user
    redeemedAt DateTime?
    expiresAt  DateTime // When reward expires
    createdAt  DateTime  @default(now())
    user       User      @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([rewardId])
    @@index([redeemedAt])
}

model TopicQuestion {
    id         String   @id @default(uuid())
    topicId    String
    authorId   String
    title      String
    content    String
    helpCount  Int      @default(0) // Number of people who marked as helpful
    viewCount  Int      @default(0)
    isResolved Boolean  @default(false) // Has a marked solution
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    topic   Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
    author  User             @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
    answers QuestionAnswer[]

    @@index([topicId])
    @@index([createdAt])
    @@index([isResolved])
    @@index([helpCount])
}

model QuestionAnswer {
    id         String   @id @default(uuid())
    questionId String
    authorId   String
    content    String
    helpCount  Int      @default(0) // Marked as helpful
    isAccepted Boolean  @default(false) // Marked as best answer
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    question TopicQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
    author   User          @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Restrict)

    @@index([questionId])
    @@index([helpCount])
    @@index([isAccepted])
}

enum RSVPStatus {
    GOING
    MAYBE
    DECLINED
}

enum UserStatus {
    STUDENT
    ALUMNI
}

enum BadgeRarity {
    COMMON
    RARE
    EPIC
    LEGENDARY
}

enum MaterialProcessingStatus {
    QUEUED
    PROCESSING
    COMPLETED
    FAILED
}

enum ConversationType {
    DIRECT
    GROUP
}

enum ConversationRole {
    OWNER
    ADMIN
    MEMBER
}
