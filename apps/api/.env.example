# ─── Server ──────────────────────────────────────────────
PORT=4000
MAX_UPLOAD_MB=50

# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vylix"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vylix"

# ─── Redis ───────────────────────────────────────────────
# Rate-limiting & caching. Keep isolated from Celery Redis to prevent
# result-backend TTLs from evicting rate-limit keys under memory pressure.
REDIS_URL="redis://localhost:6379/0"

# ─── Storage Provider ────────────────────────────────────
# Choose between "supabase" (default), "r2", or "appwrite"
STORAGE_PROVIDER=supabase

# ─── Cloudflare R2 Storage ───────────────────────────────
# S3-compatible object storage with zero egress fees; primary vault for
# materials and avatars. Get credentials from your R2 bucket settings page.
# R2_ACCOUNT_ID="<account_id>"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_STORAGE_BUCKET="vylix-materials"
# R2_AVATARS_BUCKET="vylix-avatars"
# Optional public custom domain; when unset the provider returns presigned URLs.
# R2_PUBLIC_BASE_URL=""

# ─── Supabase Storage ────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="materials"
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_JWT_SECRET=""

# ─── Appwrite Storage ────────────────────────────────────
# APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
# APPWRITE_PROJECT_ID=""
# APPWRITE_API_KEY=""
# APPWRITE_STORAGE_BUCKET_ID=""

# ─── AI ──────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Vector Search ───────────────────────────────────────
# "auto" uses pgvector when GEMINI_API_KEY is set, otherwise ChromaDB.
# Force one backend with "pgvector" or "chromadb".
VECTOR_STORE_BACKEND=auto
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CACHE_TTL_SECONDS=604800

# ─── Google Drive ────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# This is where Google redirects after user authorizes — must match Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/google-drive/callback"
# Where to send the user after Drive connection is complete
FRONTEND_URL="http://localhost:3000"

# ─── Monnify ─────────────────────────────────────────────
# Sign up at https://monnify.com and get keys from your dashboard
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_WEBHOOK_SECRET=""

# ─── Study rooms (WebRTC audio + video) ─────────────────
# STUN handles most networks. Add a TURN relay (self-hosted coturn or a
# managed provider) when students are behind symmetric NAT / campus Wi-Fi.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302"
# Comma-separated relay URLs, e.g. "turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp"
WEBRTC_TURN_URLS=""
# Preferred: coturn `--use-auth-secret` shared secret. When set, the API mints
# short-lived HMAC credentials per connection (nothing static reaches clients).
WEBRTC_TURN_SECRET=""
WEBRTC_TURN_TTL_SECONDS=3600
# Legacy static credentials (only used when WEBRTC_TURN_SECRET is empty).
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""
# Mesh calls: every peer connects to every other peer (keep small).
WEBRTC_MAX_PARTICIPANTS=6
# Cameras are heavier than audio, so mesh video rooms use a smaller cap.
WEBRTC_MAX_VIDEO_PARTICIPANTS=4

# ─── Product analytics ───────────────────────────────────
# PostHog project API key. Leave empty to disable server-side events.
POSTHOG_API_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_API_KEY=""

# NOTE: Do NOT commit secrets. Rename this file to `.env` locally and fill with
# real secrets when running locally or in CI.
