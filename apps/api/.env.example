# ─── Server ──────────────────────────────────────────────
PORT=4000
MAX_UPLOAD_MB=50

# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vylix"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vylix"

# ─── Cache / Queues ──────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─── AI Processing ───────────────────────────────────────
PYTHON_SERVICE_URL="http://localhost:8000"

# ─── Storage Provider ────────────────────────────────────
# Choose between "supabase" (default) or "appwrite"
# STORAGE_PROVIDER=supabase

# ─── Supabase Storage (default) ──────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="material"

# ─── Appwrite Storage (alternative) ──────────────────────
# APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
# APPWRITE_PROJECT_ID=""
# APPWRITE_API_KEY=""
# APPWRITE_STORAGE_BUCKET_ID=""

# ─── Maintenance ─────────────────────────────────────────
MAINTENANCE_API_KEY=""

# NOTE: Do NOT commit secrets. Rename this file to `.env` locally and fill with
# real secrets when running locally or in CI. Use your platform's secret store
# to provide production values.
