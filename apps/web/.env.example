# Rename to `.env.local` for local development. Do NOT commit secrets to git.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Optional alias if you prefer the newer Supabase naming
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Frontend -> Backend API URL (used by Next.js to call FastAPI)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Cloudflare Turnstile (bot protection on sign-in / sign-up)
# Public site key from https://dash.cloudflare.com -> Turnstile.
# Leave empty to disable the widget in local development.
# The matching secret goes in Supabase Dashboard -> Authentication -> Settings
#   -> Bot and Abuse Protection -> CAPTCHA (provider: Cloudflare Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# PostHog product analytics (optional). Leave the key empty to disable.
# Project API key + host from https://app.posthog.com -> Project settings.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Google OAuth (server-side flow for Drive access)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add this redirect URI: http://localhost:4000/api/v1/google-drive/callback (dev)
#                        https://your-api-domain.com/api/v1/google-drive/callback (prod)
# Configure Google OAuth credentials on the API server, not in the browser.
# The same Client ID may also be configured in Supabase Dashboard under
# Authentication > Providers > Google if Supabase Google sign-in is enabled.

# Backend -> Frontend URL (used by FastAPI to redirect after OAuth callback)
# FRONTEND_URL="http://localhost:3000"

# AI (AI Professor / chat) runs server-side via the FastAPI backend using
# GEMINI_API_KEY — set it on the backend, not here.
