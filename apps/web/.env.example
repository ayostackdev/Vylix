# Rename to `.env.local` for local development. Do NOT commit secrets to git.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Optional alias if you prefer the newer Supabase naming
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Google OAuth (server-side flow — avoids "Sign in to continue to supabase.co")
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add this redirect URI: http://localhost:3000/api/auth/google/callback (dev)
#                        https://yourdomain.com/api/auth/google/callback (prod)
# IMPORTANT: The same Client ID must be configured in Supabase Dashboard under
# Authentication > Providers > Google for signInWithIdToken to work.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public site URL used to construct the OAuth redirect_uri
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
 