# Rename to `.env.local` for local development. Do NOT commit secrets to git.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Optional alias if you prefer the newer Supabase naming
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Frontend -> Backend API URL (used by Next.js to call FastAPI)
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Google OAuth (server-side flow for Drive access)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Add this redirect URI: http://localhost:4000/api/google-drive/callback (dev)
#                        https://your-api-domain.com/api/google-drive/callback (prod)
# IMPORTANT: The same Client ID must be configured in Supabase Dashboard under
# Authentication > Providers > Google for signInWithIdToken to work.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Backend -> Frontend URL (used by FastAPI to redirect after OAuth callback)
# FRONTEND_URL="http://localhost:3000"

# AI (AI Professor / chat) runs server-side via the FastAPI backend using
# GEMINI_API_KEY — set it on the backend, not here.
